@model Post
<li class="post-item">
    <a class="post-item-link" href="@Links.Post(Model.Slug)">
        <time class="post-date" datetime="@Model.Date.ToString("yyyy-MM-dd")">@Model.Date.ToString("MMM d, yyyy")</time>
        <div class="post-item-body">
            <h3 class="post-title">
                @Model.Title
                @if (Model.Draft)
                {
                    <span class="draft-badge">Draft</span>
                }
            </h3>
            <p class="post-summary">@Model.Summary</p>
            <p class="post-meta">@Model.ReadingMinutes min read · @string.Join(", ", Model.Tags)</p>
        </div>
    </a>
</li>
