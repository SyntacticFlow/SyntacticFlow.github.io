@page
@model Portfolio.Web.Pages.Blog.IndexModel
@{
    ViewData["Title"] = Model.TagName is null ? "Blog" : $"Posts tagged “{Model.TagName}”";
    ViewData["Description"] = "Notes on the cool things I find in the coding world.";
}

<section class="page-header">
    <div class="container">
        <h1 class="page-title">Blog</h1>
        <p class="page-lede">Notes on the cool things I find in the coding world. <a href="/feed.xml">Subscribe via RSS</a>.</p>
        @if (Model.AllTags.Count > 0)
        {
            <nav class="filter-bar" aria-label="Filter by tag">
                <a href="@Links.Blog" class="chip" aria-current="@(Model.Tag is null ? "true" : "false")">All</a>
                @foreach (var tag in Model.AllTags)
                {
                    <a href="@Links.BlogPage(tag, 1)" class="chip" aria-current="@(tag == Model.TagName ? "true" : "false")">@tag</a>
                }
            </nav>
        }
    </div>
</section>

<section class="section section-tight">
    <div class="container">
        @if (Model.Posts.Count == 0)
        {
            <p class="empty">Nothing here yet.</p>
        }
        <ul class="post-list">
            @foreach (var post in Model.Posts)
            {
                <partial name="_PostItem" model="post" />
            }
        </ul>

        @if (Model.TotalPages > 1)
        {
            <nav class="pager" aria-label="Pages">
                @if (Model.CurrentPage > 1)
                {
                    <a class="pager-link pager-prev" href="@Links.BlogPage(Model.TagName, Model.CurrentPage - 1)"><span>Newer</span>Page @(Model.CurrentPage - 1)</a>
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a class="pager-link pager-next" href="@Links.BlogPage(Model.TagName, Model.CurrentPage + 1)"><span>Older</span>Page @(Model.CurrentPage + 1)</a>
                }
            </nav>
        }
    </div>
</section>
